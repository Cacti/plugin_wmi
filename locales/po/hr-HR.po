msgid "Check this box, if you want the WMI Plugin to query Windows devices."
msgstr "Označite ovaj okvir ako želite da dodatak WMI šalje upite Windows uređajima."

#: setup.php
msgid "Concurrent Processes"
msgstr "Istodobni procesi"

#: setup.php
msgid "How many concurrent WMI queries do you want the system to run?"
msgstr "Koliko istovremenih WMI upita želite da sustav pokreće?"

#: setup.php
msgid "Auto Create WMI Queries"
msgstr "Automatski stvori WMI upite"

#: setup.php
msgid "If selected, when running either automation, or when creating/saving a Device, all WMI Queries associated with the Device Template will be created."
msgstr "Ako je odabrano, prilikom pokretanja automatizacije ili prilikom stvaranja/spremanja uređaja, stvorit će se svi WMI upiti povezani s predloškom uređaja."

#: setup.php
msgid "Use WinRM over HTTPS"
msgstr "Koristi WinRM putem HTTPS-a"

#: setup.php
msgid "Default for accounts that inherit server settings. Configure and trust the target certificate; certificate checks are not disabled."
msgstr "Zadano za račune koji nasljeđuju postavke poslužitelja. Konfigurirajte i ukažite povjerenje ciljnom certifikatu; provjere certifikata nisu onemogućene."

#: setup.php wmi_accounts.php
msgid "WinRM Port Override"
msgstr "Nadjačavanje WinRM porta"

#: setup.php
msgid "Default port override for accounts that inherit server settings. Leave blank for the Windows default."
msgstr "Zadano nadjačavanje porta za račune koji nasljeđuju postavke poslužitelja. Ostavite prazno za zadani Windows port."

#: setup.php wmi_accounts.php
msgid "WinRM Authentication"
msgstr "WinRM autentikacija"

#: setup.php
msgid "Default for accounts that inherit server settings. Use Kerberos for domain hosts where available. Basic requires HTTPS."
msgstr "Zadano za račune koji nasljeđuju postavke poslužitelja. Koristite Kerberos za domenska računala gdje je dostupan. Osnovna autentikacija (Basic) zahtijeva HTTPS."

#: setup.php wmi_accounts.php
msgid "Negotiate"
msgstr "Negotiate"

#: setup.php wmi_accounts.php
