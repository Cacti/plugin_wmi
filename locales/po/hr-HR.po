msgstr "Dodijelite ovom računu smislen naziv koji će se prikazivati."

#: wmi_accounts.php wmi_tools.php
msgid "Username"
msgstr "Korisničko ime"

#: wmi_accounts.php
msgid "The username that will be used for authentication.  Please also include the domain if necessary."
msgstr "Korisničko ime koje će se upotrebljavati za provjeru autentičnosti. Ako je potrebno, uključite i domenu."

