msgstr "Upotrijebite WMI imenski prostor ili unesite PDH za izvorne putove brojača performansi."

#: wmi_queries.php wmi_tools.php
msgid "Query"
msgstr "Upit"

#: wmi_queries.php
msgid "Enter WQL, or for PDH enter one Windows performance counter path per line. Broad queries can return many rows; responses are capped at 16 MiB."
msgstr "Unesite WQL ili za PDH unesite po jedan put Windows brojača performansi po retku. Široki upiti mogu vratiti mnogo redaka; odgovori su ograničeni na 16 MiB."

