msgid "Use a WMI namespace, or enter PDH for native performance counter paths."
msgstr "Koristite WMI imenski prostor ili unesite PDH za izvorne putanje brojača performansi."

#: wmi_queries.php wmi_tools.php
msgid "Query"
msgstr "Upit"

#: wmi_queries.php
msgid "Enter WQL, or for PDH enter one Windows performance counter path per line. Broad queries can return many rows; responses are capped at 16 MiB."
msgstr "Unesite WQL, ili za PDH unesite po jednu putanju Windows brojača performansi po liniji. Široki upiti mogu vratiti mnogo redova; odgovori su ograničeni na 16 MiB."

#: wmi_queries.php wmi_tools.php
msgid "Primary Key"
msgstr "Primarni ključ"

