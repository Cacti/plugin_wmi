msgstr "Dajte ovom računu smislen naziv koji će biti prikazan."

#: wmi_accounts.php wmi_tools.php
msgid "Username"
msgstr "Korisničko ime"

#: wmi_accounts.php
msgid "The username that will be used for authentication.  Please also include the domain if necessary."
msgstr "Korisničko ime koje će se koristiti za autentifikaciju. Molimo uključite i domen ako je potrebno."

