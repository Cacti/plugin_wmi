msgstr "Lozinka koja se koristi za autentifikaciju."

#: wmi_accounts.php
msgid "WinRM Transport"
msgstr "WinRM transport"

#: wmi_accounts.php
msgid "Choose whether this account inherits the server setting or uses HTTP or HTTPS."
msgstr "Odaberite da li ovaj nalog nasljeđuje postavku servera ili koristi HTTP ili HTTPS."

