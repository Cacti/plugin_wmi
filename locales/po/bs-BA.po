#: setup.php
msgid "Check this box, if you want the WMI Plugin to query Windows devices."
msgstr "Označite ovo polje ako želite da WMI dodatak šalje upite Windows uređajima."

#: setup.php
msgid "Concurrent Processes"
msgstr "Istovremeni procesi"

#: setup.php
msgid "How many concurrent WMI queries do you want the system to run?"
msgstr "Koliko istovremenih WMI upita želite da sistem pokreće?"

#: setup.php
msgid "Auto Create WMI Queries"
msgstr "Automatski kreiraj WMI upite"

#: setup.php
msgid "If selected, when running either automation, or when creating/saving a Device, all WMI Queries associated with the Device Template will be created."
msgstr "Ako je odabrano, prilikom pokretanja automatizacije ili prilikom kreiranja/čuvanja uređaja, biće kreirani svi WMI upiti povezani sa šablonom uređaja."

#: setup.php
msgid "Use WinRM over HTTPS"
msgstr "Koristi WinRM preko HTTPS-a"

#: setup.php
msgid "Default for accounts that inherit server settings. Configure and trust the target certificate; certificate checks are not disabled."
msgstr "Podrazumijevano za naloge koji nasljeđuju postavke servera. Konfigurišite ciljni certifikat i označite ga kao pouzdan; provjere certifikata nisu onemogućene."

#: setup.php wmi_accounts.php
msgid "WinRM Port Override"
msgstr "Zamjena WinRM porta"

#: setup.php
msgid "Default port override for accounts that inherit server settings. Leave blank for the Windows default."
msgstr "Podrazumijevana zamjena porta za naloge koji nasljeđuju postavke servera. Ostavite prazno za podrazumijevanu Windows vrijednost."

#: setup.php wmi_accounts.php
msgid "WinRM Authentication"
msgstr "WinRM autentifikacija"

#: setup.php
msgid "Default for accounts that inherit server settings. Use Kerberos for domain hosts where available. Basic requires HTTPS."
msgstr "Podrazumijevano za naloge koji nasljeđuju postavke servera. Koristite Kerberos za domenske hostove gdje je dostupan. Basic zahtijeva HTTPS."

#: setup.php wmi_accounts.php
